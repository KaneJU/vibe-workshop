<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: launchd/install-macos.sh fills in __NODE__, __DIR__, __PATH__ and __HOST__ -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vibeworkshop.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__DIR__/server.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
    <key>PORT</key><string>5310</string>
    <key>HOST</key><string>__HOST__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__DIR__/logs/server.log</string>
  <key>StandardErrorPath</key><string>__DIR__/logs/server.err.log</string>
</dict>
</plist>
