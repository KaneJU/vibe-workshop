{
  "name": "vibe-workshop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Talk to an AI inside a 3D/VR world and build things: stack them, glue them, drive them, and build new things out of them. three.js + WebXR + Rapier physics + OpenAI Codex CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KaneJU/vibe-workshop.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "fetch:models": "node scripts/fetch-models.mjs",
    "test": "node tests/smoke.mjs",
    "test:mobile": "node tests/mobile.mjs",
    "test:control": "node tests/control.mjs",
    "test:world": "node tests/world.mjs",
    "test:physics": "node tests/physics.mjs",
    "test:examples": "node tests/examples.mjs",
    "test:xr": "node tests/xr.mjs",
    "test:photo": "node tests/photo.mjs",
    "test:adventure": "node tests/adventure.mjs",
    "test:rooms": "node tests/rooms.mjs",
    "test:coplay": "node tests/coplay.mjs",
    "test:tools": "node tests/tools.mjs",
    "test:custom-tool": "node tests/custom-tool.mjs",
    "test:room-restart": "node tests/room-restart.mjs",
    "test:builtin-refresh": "node tests/builtin-refresh.mjs",
    "test:quality": "node tests/quality.mjs",
    "test:headset": "node tests/headset-unit.mjs && node tests/headset.mjs",
    "test:flash": "node tests/flash-unit.mjs",
    "test:creation": "node tests/creation-protocol.mjs && node tests/sandbox.mjs && node tests/creation.mjs && node tests/creation-multitab.mjs",
    "test:connector": "node tests/connector-unit.mjs",
    "visual": "node tests/visual.mjs",
    "bench": "node tests/bench.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "iwer": "^2.6.0",
    "playwright": "^1.55.1"
  }
}
